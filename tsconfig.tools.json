{
    "compilerOptions": {
        "target": "ES2023",
        "lib": [ "ES2023", "DOM" ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": [ "node" ]
    },
    "include": [
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "server/src/**/*.test.ts",
        "client/src/**/*.test.ts",
        "playwright.config.ts",
        "vitest.config.ts"
    ]
}