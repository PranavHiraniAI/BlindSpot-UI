{
    "compilerOptions": {
        "target": "ES2023",
        "lib": [ "ES2023", "DOM" ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "..",
        "outDir": "../dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": [ "node" ]
    },
    "include": [ "src/**/*.ts", "../shared/**/*.ts" ],
    "exclude": [ "src/**/*.test.ts" ]
}